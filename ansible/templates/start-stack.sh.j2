#!/usr/bin/env bash
set -euo pipefail

# Retrieve GCP OAuth access token from instance metadata
TOKEN=$(curl -fsSL -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
  | grep -o '"access_token":"[^"]*' | cut -d'"' -f4)

# Fetch secrets directly from Secret Manager REST API
FETCH_SECRET() {
  local name="$1"
  local response
  response=$(curl -fsSL -H "Authorization: Bearer ${TOKEN}" \
    "https://secretmanager.googleapis.com/v1/projects/{{ gcp_project_id }}/secrets/${name}/versions/latest:access")
  echo "${response}" | grep -oE '"data"[[:space:]]*:[[:space:]]*"[^"]+' | sed -E 's/.*"([^"]+)$/\1/' | base64 -d
}

export CLOUDFLARE_TUNNEL_TOKEN=$(FETCH_SECRET "{{ tunnel_secret_id }}")
export GRAFANA_ADMIN_PASSWORD=$(FETCH_SECRET "{{ grafana_secret_id }}")
export GRAFANA_ADMIN_USER="admin"

cd {{ telemetry_dir }}
docker compose up -d
